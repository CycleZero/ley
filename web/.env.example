# ============================================================
# Ley 前端环境变量示例
# 复制为 .env 后按需修改
# ============================================================

# 开发模式（development 关闭 SSR，production 开启 SSR）
NODE_ENV=development

# API 基础地址
# WSL2 访问 Windows 宿主机：http://172.18.240.1:8080
# 本地开发（后端也在 WSL2）：http://localhost:8080
NUXT_PUBLIC_API_BASE=http://172.18.240.1:8080

# Nuxt 开发服务器
NUXT_HOST=127.0.0.1
NUXT_PORT=3000

# Vite 文件监听模式（WSL2 建议开启 polling）
NUXT_VITE_WATCH_USE_POLLING=true
